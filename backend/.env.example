# ==============================================================================
# DisasterChain Backend Environment Variables (Production & Development)
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production

# 2. Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/disasterchain?retryWrites=true&w=majority

# 3. JSON Web Token (JWT) Security Secret
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_key_change_me_in_production
JWT_EXPIRE=30d

# 4. Frontend Application URL (Used for CORS and Email Links)
# For Render deployment, set this to your Vercel frontend URL
FRONTEND_URL=https://disasterchain.vercel.app

# 5. Transactional Email Provider (SMTP) Configuration
# Supported providers: Resend, Brevo (Sendinblue), SendGrid, Amazon SES, Mailgun, Gmail SMTP
# Example for Resend (smtp.resend.com):
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
EMAIL_FROM="DisasterChain Security" <onboarding@resend.dev>

# Example for Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_key
# EMAIL_FROM="DisasterChain" <no-reply@yourdomain.com>
